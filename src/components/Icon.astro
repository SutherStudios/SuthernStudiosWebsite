---
/**
 * Icon — inline Lucide glyphs.
 *
 * The design system specifies Lucide as the icon set. Rather than shipping the
 * Lucide UMD bundle and running createIcons() on the client, the handful of
 * glyphs this site actually uses are inlined here as raw SVG paths. Same
 * artwork, no client JS, no layout shift.
 *
 * To add an icon: copy the inner markup of the .svg from lucide.dev into
 * `paths` below. Brand marks (which are filled, not stroked) go in `solid`.
 */

interface Props {
  name: string;
  size?: number;
  class?: string;
  strokeWidth?: number;
}

const { name, size = 18, class: className, strokeWidth = 2 } = Astro.props;

// Stroked glyphs — the Lucide default (24×24 viewBox, round caps and joins).
const paths: Record<string, string> = {
  'arrow-right': '<path d="M5 12h14"/><path d="m12 5 7 7-7 7"/>',
  'arrow-left': '<path d="m12 19-7-7 7-7"/><path d="M19 12H5"/>',
  'gamepad-2':
