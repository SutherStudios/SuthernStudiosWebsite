---
/**
 * NavBar — sticky, translucent, blurred over the ink canvas.
 * Mobile collapses to a disclosure button (the only client JS on the site).
 */

import { NAV_LINKS, AFTERSHOCK } from '../config';
import Button from './Button.astro';
import Icon from './Icon.astro';

const pathname = Astro.url.pathname;

/** A link is current if it's an exact match, or an ancestor of a nested route. */
function isCurrent(href: string): boolean {
  if (href === '/') return pathname === '/' || pathname === '';
  return pathname === href || pathname.startsWith(href);
}

const wishlistHref = AFTERSHOCK.steamUrl || '/games/';
---

<header class="nav">
  <div class="nav__inner">
    <a href="/" class="nav__brand" aria-label={`${'Suthern Studios'} — home`}>
      <img src="/assets/logo-mark.png" alt="" width="32" height="40" class="nav__mark" />
      <span class="nav__wordmark">Suthern Studios</span>
    </a>

    <button
      type="button"
      class="nav__toggle"
      aria-expanded="false"
      aria-controls="nav-menu"
      aria-label="Open menu"
      data-nav-toggle
    >
      <span class="nav__toggle-open"><Icon name="menu" size={20} /></span>
      <span class="nav__toggle-close"><Icon name="x" size={20} /></span>
    </button>

    <div class="nav__menu" id="nav-menu" data-nav-menu>
      <ul class="nav__links" role="list">
        {
          NAV_LINKS.map((link) => (
            <li>
              <a
                href={link.href}
                class:list={['nav__link', isCurrent(link.href) && 'nav__link--current']}
                aria-current={isCurrent(link.href) ? 'page' : undefined}
              >
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
      <Button
        size="sm"
        href={wishlistHref}
        external={Boolean(AFTERSHOCK.steamUrl)}
        class="nav__cta"
      >
        Wishlist
      </Button>
    </div>
  </div>
</header>

<style>
  .nav {
    position: sticky;
    top: 0;
    z-index: 50;
    background: rgba(10, 12, 19, 0.72);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    border-bottom: 1px solid var(--border-subtle);
  }

  .nav__inner {
    max-width: var(--container-xl);
    margin-inline: auto;
    padding: 14px var(--space-7);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-5);
  }

  /* ---- BRAND ---- */

  .nav__brand {
    display: flex;
    align-items: center;
    gap: 11px;
    text-decoration: none;
    flex-shrink: 0;
  }

  /* logo-mark.png is trimmed tight to the glyph (native 20×25 art grid), so
     no border-radius here — rounding would clip the mark rather than the
     empty padding the untrimmed asset used to carry. */
  .nav__mark {
    width: auto;
    height: 40px;
    image-rendering: pixelated;
  }

  .nav__wordmark {
    font-family: var(--font-display);
    font-weight: var(--fw-bold);
    font-size: 15px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--text-primary);
    transition: color var(--dur-fast) var(--ease-out);
  }

  .nav__brand:hover .nav__wordmark {
    color: var(--ember-400);
  }

  /* ---- MENU ---- */

  .nav__menu {
    display: flex;
    align-items: center;
    gap: 26px;
  }

  .nav__links {
    display: flex;
    gap: 22px;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .nav__link {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    text-decoration: none;
    color: var(--text-secondary);
    transition: color var(--dur-fast) var(--ease-out);
    white-space: nowrap;
  }

  .nav__link:hover {
    color: var(--text-primary);
  }

  .nav__link--current {
    color: var(--ember-400);
  }

  /* ---- MOBILE TOGGLE ---- */

  .nav__toggle {
    display: none;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    background: transparent;
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-sm);
    color: var(--text-primary);
    cursor: pointer;
    transition: border-color var(--dur-fast) var(--ease-out);
  }

  .nav__toggle:hover {
    border-color: var(--border-strong);
  }

  .nav__toggle-close {
    display: none;
  }

  .nav__toggle[aria-expanded='true'] .nav__toggle-open {
    display: none;
  }

  .nav__toggle[aria-expanded='true'] .nav__toggle-close {
    display: inline-flex;
  }

  /* ---- RESPONSIVE ---- */

  @media (max-width: 860px) {
    .nav__inner {
      flex-wrap: wrap;
      padding-inline: var(--space-5);
    }

    .nav__toggle {
      display: inline-flex;
    }

    .nav__menu {
      display: none;
      flex-basis: 100%;
      flex-direction: column;
      align-items: stretch;
      gap: var(--space-5);
      padding: var(--space-6) 0 var(--space-4);
      border-top: 1px solid var(--border-subtle);
      margin-top: var(--space-4);
    }

    .nav__menu[data-open] {
      display: flex;
    }

    .nav__links {
      flex-direction: column;
      gap: var(--space-5);
    }

    .nav__link {
      font-size: var(--text-sm);
      display: block;
      padding-block: var(--space-1);
    }

    .nav__cta {
      align-self: flex-start;
    }
  }
</style>

<script>
  // The site's only client-side script: an accessible mobile disclosure.
  const toggle = document.querySelector<HTMLButtonElement>('[data-nav-toggle]');
  const menu = document.querySelector<HTMLElement>('[data-nav-menu]');

  if (toggle && menu) {
    const setOpen = (open: boolean) => {
      toggle.setAttribute('aria-expanded', String(open));
      toggle.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
      menu.toggleAttribute('data-open', open);
    };

    toggle.addEventListener('click', () => {
      setOpen(toggle.getAttribute('aria-expanded') !== 'true');
    });

    // Escape closes and returns focus to the trigger.
    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && toggle.getAttribute('aria-expanded') === 'true') {
        setOpen(false);
        toggle.focus();
      }
    });

    // Reset when resizing back up to the desktop layout, so the menu doesn't
    // stay stuck open behind a hidden toggle.
    const desktop = window.matchMedia('(min-width: 861px)');
    desktop.addEventListener('change', (event) => {
      if (event.matches) setOpen(false);
    });
  }
</script>
