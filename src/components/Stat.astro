---
/** Stat — big display numeral with a mono label. Specs, metrics, dev counts. */

interface Props {
  value: string;
  label: string;
  sublabel?: string;
  accent?: 'ember' | 'cyan' | 'gold';
  class?: string;
}

const { value, label, sublabel, accent = 'ember', class: className } = Astro.props;

const classes = ['stat', `stat--${accent}`, className].filter(Boolean).join(' ');
---

<div class={classes}>
  <div class="stat__value">{value}</div>
  <div class="stat__label">{label}</div>
  {sublabel && <div class="stat__sublabel">{sublabel}</div>}
</div>

<style>
  .stat {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .stat__value {
    font-family: var(--font-display);
    font-weight: var(--fw-bold);
    font-size: var(--text-3xl);
    line-height: 1;
    letter-spacing: -0.01em;
  }

  .stat--ember .stat__value {
    color: var(--ember-400);
  }
  .stat--cyan .stat__value {
    color: var(--cyan-400);
  }
  .stat--gold .stat__value {
    color: var(--gold-500);
  }

  .stat__label {
    font-family: var(--font-mono);
    font-size: var(--text-2xs);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--text-secondary);
    margin-top: var(--space-2);
  }

  .stat__sublabel {
    font-size: 13px;
    color: var(--text-muted);
  }

  @media (max-width: 640px) {
    .stat__value {
      font-size: var(--text-2xl);
    }
  }
</style>
