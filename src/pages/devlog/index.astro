---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Eyebrow from '../../components/Eyebrow.astro';
import Icon from '../../components/Icon.astro';
import Newsletter from '../../components/Newsletter.astro';
import Tag from '../../components/Tag.astro';
import { formatDotted, toISODate } from '../../utils/date';

// Drafts stay out of production builds but show up in `npm run dev`.
const posts = (await getCollection('devlog', ({ data }) => import.meta.env.DEV || !data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);
---

<BaseLayout
  title="Devlog"
  description="Development happens in the open. Build logs from Suthern Studios — what's changing in AfterShock, build by build."
>
  <div class="container container--md page">
    <Eyebrow>// Build logs</Eyebrow>
    <h1 class="page__title">Devlog</h1>
    <p class="page__lede">
      Development happens in the open. Here's what's been changing, build by build.
    </p>

    {
      posts.length === 0 ? (
        <p class="empty">&gt; No entries yet. First build log lands soon.</p>
      ) : (
        <div class="posts">
          {posts.map((post) => (
            <article class="post">
              <span
                class:list={['post__edge', `post__edge--${post.data.accent}`]}
                aria-hidden="true"
              />

              <div class="post__meta">
                <time datetime={toISODate(post.data.date)} class="post__date">
                  {formatDotted(post.data.date)}
                </time>
                {post.data.build && <span class="post__build">build {post.data.build}</span>}
                <Tag>{post.data.tag}</Tag>
                {post.data.draft && <Tag active>Draft</Tag>}
              </div>

              <h2 class="post__title">
                <a href={`/devlog/${post.id}/`}>{post.data.title}</a>
              </h2>
              <p class="post__summary">{post.data.summary}</p>

              <a href={`/devlog/${post.id}/`} class="post__link">
                Read entry <Icon name="arrow-right" size={14} />
              </a>
            </article>
          ))}
        </div>
      )
    }
  </div>

  <Newsletter />
</BaseLayout>

<style>
  .page {
    padding-top: var(--space-11);
  }

  .page__title {
    font-family: var(--font-display);
    font-weight: var(--fw-bold);
    font-size: clamp(36px, 6vw, 48px);
    letter-spacing: var(--tracking-tight);
    color: var(--text-primary);
    margin: var(--space-4) 0 var(--space-3);
  }

  .page__lede {
    font-size: 17px;
    color: var(--text-secondary);
    margin: 0 0 var(--space-10);
    max-width: 560px;
  }

  .empty {
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    color: var(--text-muted);
    padding-block: var(--space-9);
  }

  .posts {
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
  }

  .post {
    position: relative;
    background: var(--surface-2);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-lg);
    padding: var(--space-7) var(--space-8);
    overflow: hidden;
    transition:
      transform var(--dur-base) var(--ease-out),
      box-shadow var(--dur-base) var(--ease-out),
      border-color var(--dur-base) var(--ease-out);
  }

  .post:hover {
    transform: translateY(-3px);
    box-shadow: var(--shadow-3);
    border-color: var(--border-strong);
  }

  .post__edge {
    position: absolute;
    top: 0;
    left: 0;
    bottom: 0;
    width: 3px;
  }

  .post__edge--ember {
    background: var(--ember-500);
  }

  .post__edge--cyan {
    background: var(--cyan-500);
  }

  .post__meta {
    display: flex;
    align-items: center;
    gap: var(--space-5);
    margin-bottom: var(--space-5);
    flex-wrap: wrap;
  }

  .post__date {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--text-muted);
    letter-spacing: 0.06em;
  }

  .post__build {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--accent-2);
  }

  .post__title {
    font-family: var(--font-display);
    font-weight: var(--fw-semibold);
    font-size: 22px;
    margin: 0 0 10px;
    letter-spacing: -0.01em;
  }

  .post__title a {
    color: var(--text-primary);
    text-decoration: none;
  }

  /* Stretch the title link across the whole card so the entire panel is
     clickable, while keeping a single link in the accessibility tree. */
  .post__title a::after {
    content: '';
    position: absolute;
    inset: 0;
  }

  .post__title a:hover {
    color: var(--ember-400);
  }

  .post__summary {
    font-size: 15.5px;
    line-height: var(--lh-relaxed);
    color: var(--text-body);
    margin: 0;
  }

  .post__link {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    margin-top: var(--space-5);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ember-400);
    text-decoration: none;
  }

  @media (max-width: 720px) {
    .page {
      padding-top: var(--space-9);
    }

    .post {
      padding: var(--space-6);
    }
  }
</style>
