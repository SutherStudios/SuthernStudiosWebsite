---
/**
 * Games — currently a single-title showcase for AfterShock.
 *
 * The design system's reference build puts Overview / Features / Specs behind
 * a Tabs component. Here they're stacked as three sections instead: the copy is
 * short, it keeps every word indexable for search and social crawlers, and it
 * avoids shipping JS to hide content the visitor came to read.
 */

import BaseLayout from '../../layouts/BaseLayout.astro';
import Badge from '../../components/Badge.astro';
import Button from '../../components/Button.astro';
import Eyebrow from '../../components/Eyebrow.astro';
import Icon from '../../components/Icon.astro';
import Newsletter from '../../components/Newsletter.astro';
import Tag from '../../components/Tag.astro';
import { AFTERSHOCK } from '../../config';

const hasSteam = AFTERSHOCK.steamUrl.length > 0;
const hasKeyArt = AFTERSHOCK.keyArt.length > 0;
---

<BaseLayout
  title={AFTERSHOCK.title}
  description={AFTERSHOCK.summary}
  image={hasKeyArt ? AFTERSHOCK.keyArt : undefined}
>
  <div class="container page">
    <Eyebrow>// Program: {AFTERSHOCK.title}</Eyebrow>

    <!-- ================= HERO ================= -->
    <div class="hero">
      <div class="hero__art">
        {
          hasKeyArt ? (
            <img
              src={AFTERSHOCK.keyArt}
              alt={`${AFTERSHOCK.title} key art`}
              width="1200"
              height="630"
              loading="eager"
            />
          ) : (
            /* Branded title card — stands in until real key art ships. */
            <div class="titlecard">
              <span class="grid-plane titlecard__grid" aria-hidden="true" />
              <span class="horizon-line titlecard__horizon" aria-hidden="true" />
              <div class="titlecard__inner">
                <span class="titlecard__eyebrow">// Colony simulation</span>
                <span class="titlecard__title">{AFTERSHOCK.title}</span>
                <span class="titlecard__tagline">{AFTERSHOCK.tagline}</span>
              </div>
            </div>
          )
        }
        <span class="hero__badge"><Badge tone="ember" variant="solid" dot>{AFTERSHOCK.status}</Badge></span>
      </div>

      <div class="hero__copy">
        <div class="hero__tags">
          {AFTERSHOCK.genres.map((genre) => <Tag>{genre}</Tag>)}
        </div>

        <h1 class="hero__title">{AFTERSHOCK.title}</h1>
        <p class="hero__tagline">{AFTERSHOCK.tagline}</p>
        <p class="hero__summary">{AFTERSHOCK.summary}</p>

        <div class="hero__actions">
          <Button
            size="lg"
            href={hasSteam ? AFTERSHOCK.steamUrl : undefined}
            external={hasSteam}
            disabled={!hasSteam}
            leadingIcon="heart"
          >
            {hasSteam ? 'Wishlist on Steam' : 'Steam page soon'}
          </Button>
          <Button size="lg" variant="ghost" href="/devlog/" leadingIcon="rss">Follow dev</Button>
        </div>
      </div>
    </div>

    <!-- ================= OVERVIEW ================= -->
    <section class="section">
      <Eyebrow>// Overview</Eyebrow>
      <h2 class="section__title">What you're getting into</h2>
      <div class="prose">
        <p>
          Every world is procedurally generated from a single seed — layering terrain, climate,
          biomes, radiation zones, ruined cities, and road networks across a full world map before
          you place your first wall.
        </p>
        <p>
          Your colonists are more than numbers. They get hungry, exhausted, and stressed. Assign
          jobs, prioritize work, build defenses, and craft gear through a flexible production
          system. When raiders come, your colonists fight back with cover and tactical AI.
        </p>
        <p class="prose__emphasis">
          Every system connects — what you grow feeds who you keep alive.
        </p>
      </div>
    </section>

    <!-- ================= FEATURES ================= -->
    <section class="section">
      <Eyebrow>// Features</Eyebrow>
      <h2 class="section__title">Systems, not checkboxes</h2>
      <div class="features">
        {
          AFTERSHOCK.features.map((feature) => (
            <div class="feature">
              <span class="feature__icon"><Icon name={feature.icon} size={20} /></span>
              <div>
                <h3 class="feature__title">{feature.title}</h3>
                <p class="feature__body">{feature.body}</p>
              </div>
            </div>
          ))
        }
      </div>
    </section>

    <!-- ================= SPECS ================= -->
    <section class="section">
      <Eyebrow>// Specs</Eyebrow>
      <h2 class="section__title">Under the hood</h2>
      <dl class="specs">
        {
          AFTERSHOCK.specs.map(([key, value]) => (
            <div class="spec">
              <dt class="spec__key">{key}</dt>
              <dd class="spec__value">{value}</dd>
            </div>
          ))
        }
      </dl>
    </section>
  </div>

  <Newsletter />
</BaseLayout>

<style>
  .page {
    padding-top: var(--space-11);
  }

  /* ---- HERO ---- */

  .hero {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr);
    gap: 36px;
    align-items: center;
    margin-top: var(--space-6);
  }

  .hero__art {
    position: relative;
    border-radius: var(--radius-lg);
    overflow: hidden;
    border: 1px solid var(--border-subtle);
    box-shadow: var(--shadow-3);
  }

  .hero__art img {
    width: 100%;
    aspect-ratio: 16 / 9;
    object-fit: cover;
  }

  .hero__badge {
    position: absolute;
    top: var(--space-4);
    left: var(--space-4);
    z-index: 1;
  }

  /* ---- TITLE CARD (key-art stand-in) ---- */

  .titlecard {
    position: relative;
    overflow: hidden;
    aspect-ratio: 16 / 9;
    display: flex;
    align-items: center;
    justify-content: center;
    background:
      radial-gradient(110% 90% at 50% 120%, rgba(255, 107, 61, 0.28), transparent 62%),
      radial-gradient(80% 70% at 50% -10%, rgba(123, 91, 255, 0.2), transparent 58%),
      var(--ink-1000);
  }

  .titlecard__grid {
    opacity: 0.85;
  }

  .titlecard__horizon {
    bottom: 34%;
    opacity: 0.55;
  }

  .titlecard__inner {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-3);
    text-align: center;
    padding-inline: var(--space-6);
  }

  .titlecard__eyebrow {
    font-family: var(--font-mono);
    font-size: var(--text-2xs);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--cyan-500);
  }

  .titlecard__title {
    font-family: var(--font-display);
    font-weight: var(--fw-bold);
    font-size: clamp(32px, 6.5vw, 64px);
    line-height: 1;
    letter-spacing: var(--tracking-tight);
    background: var(--grad-sunset);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  .titlecard__tagline {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: 0.08em;
    color: var(--text-secondary);
  }

  .hero__tags {
    display: flex;
    flex-wrap: wrap;
    gap: 7px;
    margin-bottom: var(--space-5);
  }

  .hero__title {
    font-family: var(--font-display);
    font-weight: var(--fw-bold);
    font-size: clamp(38px, 5vw, 52px);
    line-height: 1;
    letter-spacing: var(--tracking-tight);
    color: var(--text-primary);
    margin: 0;
  }

  .hero__tagline {
    font-size: var(--text-md);
    color: var(--ember-300);
    font-weight: var(--fw-medium);
    margin: var(--space-4) 0 var(--space-5);
  }

  .hero__summary {
    font-size: var(--text-base);
    line-height: var(--lh-relaxed);
    color: var(--text-secondary);
    margin: 0 0 var(--space-7);
  }

  .hero__actions {
    display: flex;
    gap: var(--space-4);
    flex-wrap: wrap;
  }

  /* ---- SECTIONS ---- */

  .section {
    padding-block: var(--space-11) 0;
  }

  .section__title {
    font-family: var(--font-display);
    font-weight: var(--fw-semibold);
    font-size: var(--text-2xl);
    color: var(--text-primary);
    margin: var(--space-4) 0 var(--space-7);
    letter-spacing: -0.01em;
  }

  .prose {
    max-width: 760px;
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
    font-size: var(--text-base);
    line-height: 1.8;
    color: var(--text-body);
  }

  .prose__emphasis {
    color: var(--text-primary);
    font-weight: var(--fw-medium);
  }

  /* ---- FEATURES ---- */

  .features {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: var(--space-5);
  }

  .feature {
    display: flex;
    gap: var(--space-5);
    padding: var(--space-6);
    background: var(--surface-2);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-md);
  }

  .feature__icon {
    color: var(--cyan-400);
    flex-shrink: 0;
    margin-top: 2px;
  }

  .feature__title {
    font-family: var(--font-display);
    font-weight: var(--fw-semibold);
    font-size: 15px;
    color: var(--text-primary);
    margin: 0 0 var(--space-2);
  }

  .feature__body {
    font-size: 13.5px;
    color: var(--text-secondary);
    line-height: 1.55;
    margin: 0;
  }

  /* ---- SPECS ---- */

  .specs {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 1px;
    background: var(--border-subtle);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-md);
    overflow: hidden;
    margin: 0;
  }

  .spec {
    background: var(--surface-2);
    padding: var(--space-6) var(--space-6);
  }

  .spec__key {
    font-family: var(--font-mono);
    font-size: var(--text-2xs);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--text-muted);
    margin-bottom: 6px;
  }

  .spec__value {
    font-family: var(--font-display);
    font-weight: var(--fw-semibold);
    font-size: var(--text-base);
    color: var(--text-primary);
    margin: 0;
  }

  /* ---- RESPONSIVE ---- */

  @media (max-width: 900px) {
    .hero {
      grid-template-columns: 1fr;
      gap: var(--space-8);
    }
  }

  @media (max-width: 720px) {
    .page {
      padding-top: var(--space-9);
    }

    .section {
      padding-top: var(--space-10);
    }
  }
</style>
